# 이 파일을 복사해 이름을 .env 로 바꾸고 값을 채운다. .env 는 저장소에 올리지 않는다(.gitignore).
# 워커(gentle-lab)의 시크릿 RELAY_TOKEN 과 같은 값(16자 이상, 아무 긴 문자열)
RELAY_TOKEN=
# 서울 열린데이터광장에서 받은 '실시간 지하철' 인증키. 여러 개면 쉼표로 구분
SEOUL_API_KEYS=
# 아래는 바꾸지 않아도 된다
# WORKER_URL=https://gentle-lab-7e47subway-api.phg0643.workers.dev
# DAILY_BUDGET_PER_KEY=1000
# POLL_SEC=8
# 호출을 고르게 나눠 쓰는 시간대(한국 시각, 기본 05시~24시) 와 한꺼번에 몰아 쓰는 최대 건수(작을수록 고름).
# 앱 출시 후 호출이 늘면 여기서 키 개수/시간대/한도를 다시 조정한다.
# SERVICE_START_HOUR=5
# SERVICE_END_HOUR=24
# BURST_MAX=4
