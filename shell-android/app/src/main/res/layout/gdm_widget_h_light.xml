<?xml version="1.0" encoding="utf-8"?>
<!-- 캐릭터 시계 위젯(가로 · 화이트). 시계 글자는 시스템 TextClock, 캐릭터는 gw_overlay 의 비트맵, 출퇴근 말풍선·버튼은 gw_cmt. 자리·크기는 WidgetCore 가 padding 으로 정한다. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextClock
        android:id="@+id/gw_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:format12Hour="M월 d일 EEEE"
        android:format24Hour="M월 d일 EEEE"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#6B6B73"
        android:textSize="11dp"/>

    <TextClock
        android:id="@+id/gw_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="6"
        android:textSize="40dp"/>

    <ImageView
        android:id="@+id/gw_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"/>

    <LinearLayout
        android:id="@+id/gw_cmt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/gw_bubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/gdm_bubble_light"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/gw_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gdm_btn_light"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#111114"
            android:textSize="14dp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
